# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# --- Model provider ---
# Microsoft Agent Framework supports OpenAI / Azure OpenAI clients out of the
# box. Set whichever provider you intend to use; only one is required.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub ---
# Fine-grained PAT with `repo` scope (read issues, push branches, open PRs).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Redis (trajectory memory) ---
REDIS_HOST=localhost
REDIS_PORT=6379
