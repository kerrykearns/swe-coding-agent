# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# --- Model provider (Groq, via OpenAI-compatible client) ---
# Microsoft Agent Framework's chat clients target OpenAI-shaped APIs, so we
# point an OpenAI client at Groq's base URL rather than api.openai.com.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub ---
# Fine-grained PAT with `repo` scope (read issues, push branches, open PRs).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Redis (trajectory memory) ---
REDIS_HOST=localhost
REDIS_PORT=6379
