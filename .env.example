# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# --- Model provider (Groq, via OpenAI-compatible client) ---
# Microsoft Agent Framework's chat clients target OpenAI-shaped APIs, so we
# point an OpenAI client at Groq's base URL rather than api.openai.com.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub ---
# Fine-grained PAT with `repo` scope (read issues, push branches, open PRs).
# M4 only reads issues and clones, so read access to Issues + Contents is
# enough for now; write access is not exercised until the M6 safety gate lands.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Repository the GitHub integration tests read (they are skipped without a
# token). Must have an open issue #1; see tests/test_github_client.py.
GITHUB_TEST_REPO=kerrykearns/agent-test-playground

# --- Redis (trajectory memory) ---
REDIS_HOST=localhost
REDIS_PORT=6379
